pipeline {
    agent any
    environment {
        TARGET_SERVER = "16.170.204.45"
        TARGET_USER   = "jenkins"
    }
    stages {
        stage('Deploy from Git') {
            steps {
                sshagent(['3b17d0d9-2524-4dd6-9ddf-90bf4e92dcaf']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no $TARGET_USER@$TARGET_SERVER "
                            # Update system and install git (requires sudo)
                            sudo apt-get update -y && sudo apt-get install -y git

                            # Clean old code
                            rm -rf /home/jenkins/tjfhm

                            # Clone repo
                            git clone -b test https://github.com/sandraimmaculate/tjfhm.git /home/jenkins/tjfhm

                            # Run deployment script
                            cd /home/jenkins/tjfhm
                            chmod +x codedeployment.sh
                            ./codedeployment.sh
                        "
                    """
                }
            }
        }
    }
}