pipeline {
    agent any
    environment {
        TARGET_SERVER = "16.171.15.62"
        TARGET_USER   = "jenkins"
    }
    stages {
        stage('Deploy from Git') {
            steps {
                sshagent(['704fb461-cf6d-4f4b-9c8f-56233a6b34d4']) { // Jenkins credentials ID
                    sh """
                    ssh -o StrictHostKeyChecking=no $TARGET_USER@$TARGET_SERVER << ENDSSH
                        cd /tmp
                        rm -rf tjfhm
                        git clone -b test https://github.com/sandraimmaculate/tjfhm.git
                        cd tjfhm
                        chmod +x codedeployment.sh
                        ./codedeployment.sh
                    ENDSSH
                    """
                }
            }
        }
    }
}

