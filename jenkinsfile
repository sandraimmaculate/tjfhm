pipeline {
    agent any
    environment {
        TARGET_SERVER = "13.60.80.114"
        TARGET_USER   = "jenkins"
    }
    stages {
        stage('Deploy from Git') {
            steps {
                sshagent(['ssh-qa-server']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no $TARGET_USER@$TARGET_SERVER << 'ENDSSH'
                        # Pull latest deploy.sh from Git
                        cd /tmp
                        git clone -b https://github.com/sandraimmaculate/tjfhm.git
                        chmod +x codedeployment.sh
                        ./codedeployment.sh
                    ENDSSH
                    """
                }
            }
        }
    }
}
